Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Todo se sirve desde public/. Nada fuera de esa carpeta (storage, vendor,
    # config, respaldos, docs...) es accesible por web, aunque el archivo exista.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^(\.env.*|\.htaccess|\.git.*|artisan|composer\.(json|lock)|phpunit\.xml|package(-lock)?\.json|vite\.config\.js)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
